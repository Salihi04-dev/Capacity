NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=1
DATABASE_URL=postgresql://capacity:capacity@localhost:5432/capacity?schema=public
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=debug
# Provider adapter modes: fake adapters are allowed only in development/test.
PAYMENT_ADAPTER=unconfigured
SMS_ADAPTER=unconfigured
EMAIL_ADAPTER=unconfigured
PUSH_ADAPTER=unconfigured
MAPS_ADAPTER=unconfigured
FILE_STORAGE_ADAPTER=unconfigured
